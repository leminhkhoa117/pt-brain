# ===== Server =====
NODE_ENV=development
PORT=4000

# MongoDB (local) hoặc Atlas khi deploy
MONGO_URI=mongodb://127.0.0.1:27017/pt-brain

# JWT - BẮT BUỘC đổi khi deploy (tối thiểu 16 ký tự)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS / cookie
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SERVE_CLIENT=false

# Nơi lưu ảnh/PDF: 'disk' cho local, 'mongo' (GridFS) cho Render free
STORAGE_DRIVER=disk

# ===== AI (OpenCode Go - OpenAI-compatible) =====
# API key CHỈ nằm ở backend, không bao giờ đưa vào client (không dùng tiền tố VITE_)
AI_PROVIDER=opencode-go
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
AI_VISION_MODEL=gemini-4-argon
AI_TIMEOUT_MS=180000
AI_DAILY_LIMIT_PER_USER=30

# Email liên hệ cho Crossref/Unpaywall và User-Agent (polite pool)
CONTACT_EMAIL=you@example.com
# Giới hạn upload PDF
PDF_MAX_MB=20

# ===== Client (Vite) =====
VITE_API_BASE=/api
