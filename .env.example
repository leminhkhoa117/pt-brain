# ===== Server =====
NODE_ENV=development
PORT=4000

# MongoDB (local) hoặc Atlas khi deploy
MONGO_URI=mongodb://127.0.0.1:27017/pt-brain

# JWT - BẮT BUỘC đổi khi deploy (tối thiểu 16 ký tự)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS / cookie
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# ===== AI (dùng từ Giai đoạn 2) =====
# API key CHỈ nằm ở backend, không bao giờ đưa vào client
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_DAILY_LIMIT_PER_USER=30

# ===== Client (Vite) =====
VITE_API_BASE=/api
